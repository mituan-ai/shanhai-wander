# Copy to .env. Defaults run locally without any map credentials.
DJANGO_ENV=development
# Leave blank to generate once in data/.secret_key. Back up that file with the database.
# If you supply your own secret, use at least 50 cryptographically random characters.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
# Docker overrides this to /app/data. Relative paths work for local development.
DATA_DIR=data
TRUST_PROXY=false

# Production Caddy domain only: no https://, path, or trailing slash.
DOMAIN=trip.example.com

# AMap Web Service Key: server only; never put it in JS or a public repository.
AMAP_WEB_KEY=
# AMap JS Key is public; the security code stays in the server-side SDK proxy.
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
